---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlantList from '../../components/PlantList.astro';
import AudioGuide from '../../components/AudioGuide.astro';
import { publishedPlants } from '../../lib/plants';
---
<BaseLayout title="植物名錄" description="沿著好美里 1920 保安林的 15 個植物導覽點，認識海岸植物。">
  <div class="container directory-page">
    <header class="page-heading">
      <h1>植物名錄</h1>
      <p class="lead">依步道站號排列，共 {publishedPlants.length} 個植物導覽點。</p>
    </header>
    <PlantList plants={publishedPlants} />
    <div class="directory-audio">
      <AudioGuide plants={publishedPlants} />
    </div>
  </div>
</BaseLayout>

<style>
  .directory-audio { margin-top: 28px; }
</style>
