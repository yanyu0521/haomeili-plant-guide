---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publishedPlants } from '../lib/plants';
import { plantPath, sitePath } from '../lib/paths';
import mapPlate from '../../assets/plates/map-art.png';

const firstPlants = publishedPlants.slice(0, 3);
const pointCount = publishedPlants.length;
const shortCues: Record<string, string> = {
  'hibiscus-tiliaceus': '心形葉背有灰白細毛',
  'casuarina-equisetifolia': '綠色細枝一節接一節',
  'lumnitzera-racemosa': '厚葉聚在枝端，前端較寬',
};
---
<BaseLayout title="好美里 1920 保安林" description={`沿著好美里保安林步道，找找地圖上的 ${pointCount} 個植物導覽點。`}>
  <div class="trail-home">
    <section class="trail-cover" aria-labelledby="home-title">
      <img class="cover-map" src={mapPlate.src} width={mapPlate.width} height={mapPlate.height} alt="" fetchpriority="high" />
      <div class="cover-copy">
        <p class="cover-place">美漾森林 · 地圖預覽</p>
        <h1 id="home-title">好美里<br /><span class="cover-year">1920</span> 保安林</h1>
        <p class="cover-intro">沿著步道，認識 {pointCount} 個植物導覽點。</p>
        <div class="cover-actions">
          <a class="open-map" href={sitePath('map/')}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 5 6-2 6 2 6-2v16l-6 2-6-2-6 2zM9 3v16M15 5v16" /></svg>
            開啟互動地圖
          </a>
          <a class="open-audio" href={sitePath('plants/#audio-guide')}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13v-2a8 8 0 0 1 16 0v2" /><rect x="3" y="12" width="4" height="7" rx="1.8" /><rect x="17" y="12" width="4" height="7" rx="1.8" /></svg>
            聽植物介紹
          </a>
        </div>
      </div>
    </section>

    <section class="stop-shelf" aria-labelledby="plant-rail-title">
      <div class="shelf-heading">
        <h2 id="plant-rail-title">步道前 {firstPlants.length} 站</h2>
        <a class="shelf-link" href={sitePath('plants/')} aria-label={`瀏覽全部 ${pointCount} 個植物導覽點`}>全部 {pointCount} 點 <span aria-hidden="true">→</span></a>
      </div>
      <ol class="stop-cards">
        {firstPlants.map((plant, index) => (
          <li>
            <a class="plant-rail-card" href={plantPath(plant.slug)} aria-label={`第 ${index + 1} 個點位：${plant.name}，查看植物介紹`}>
              <div class="card-plate">
                <span class="card-stop" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <img class="plant-symbol" src={sitePath(`plants/${plant.image.file}`)} alt="" width="128" height="128" decoding="async" />
              </div>
              <h3>{plant.name}</h3>
              <p>{shortCues[plant.slug] ?? plant.fieldCue}</p>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="trail-game" aria-labelledby="game-title">
      <span class="game-symbol" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="m5 11 6-8 6 8M2 15c5-6 9 6 14 0 2-2 3-2 6-1M2 20c5-6 9 6 14 0 2-2 3-2 6-1" /></svg>
      </span>
      <div class="game-copy">
        <h2 id="game-title">岸全第一</h2>
        <p>用桌遊認識海岸風險</p>
      </div>
      <a class="shelf-link" href="https://haomeili-game.angela950730.workers.dev/" target="_blank" rel="noopener noreferrer">開始遊戲 <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</BaseLayout>

<style>
  .trail-home {
    --gutter: max(clamp(19px, 4.5vw, 80px), calc((100% - 1240px) / 2));
    font-family: var(--body);
  }
  .trail-cover {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: end;
    min-height: clamp(400px, 53vw, 600px);
    padding: 145px var(--gutter) clamp(10px, 3vw, 44px);
  }
  .cover-map,
  .trail-cover::before {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cover-map {
    z-index: -2;
    object-fit: cover;
    object-position: center 52%;
  }
  .trail-cover::before {
    z-index: -1;
    content: '';
    background: linear-gradient(180deg, rgb(7 23 24 / .71), rgb(7 24 23 / .09) 25%, rgb(10 24 24 / .03) 38%, rgb(10 24 24 / .72) 68%, var(--night) 95%),
      linear-gradient(90deg, rgb(10 24 24 / .33), transparent 75%);
  }
  .cover-place {
    margin: 0 0 6px;
    color: #d2f4db;
    font-size: 12px;
    font-weight: 650;
    letter-spacing: .15em;
  }
  .trail-cover h1 {
    margin: 0;
    font-family: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", var(--body);
    color: #fafaf3;
    font-size: clamp(48px, 6.3vw, 84px);
    line-height: 1.065;
    letter-spacing: -.035em;
    font-weight: 850;
  }
  .cover-year { font-family: Arial, sans-serif; letter-spacing: -.025em; }
  .cover-intro { margin: 10px 0 17px; color: #e3eae6; font-size: clamp(14px, 1.5vw, 19px); }
  .cover-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; }
  .cover-actions a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 15px;
    border-radius: 5px;
    color: #102a23;
    background: #92efd3;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
  }
  .cover-actions svg, .game-symbol svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .open-map::after { position: absolute; z-index: 1; inset: 0; content: ''; }
  .cover-actions .open-audio { position: relative; z-index: 2; background: #28403c; color: #eaf9ef; }
  .open-map:hover { background: #a9f9e1; }
  .cover-actions .open-audio:hover { background: #35544e; }

  .stop-shelf { padding: clamp(14px, 2vw, 32px) var(--gutter) 0; }
  .shelf-heading, .trail-game { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .shelf-heading h2, .trail-game h2, .plant-rail-card h3 { margin: 0; font-family: var(--body); }
  .shelf-heading h2 { font-size: clamp(23px, 2.6vw, 34px); }
  .shelf-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 44px;
    color: #a4dacf;
    font-size: 14px;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }
  .shelf-link:hover { text-decoration: underline; }
  .stop-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(10px, 1.5vw, 22px);
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }
  .plant-rail-card {
    display: block;
    padding: 0;
    color: var(--paper);
    background: none;
    border: none;
    border-radius: 5px;
    text-decoration: none;
  }
  .card-plate {
    display: grid;
    place-items: center;
    position: relative;
    aspect-ratio: 2 / 1;
    border-radius: 5px;
    background: #d9d5b7;
    overflow: hidden;
  }
  li:nth-child(2) .card-plate { background: #bad2bc; }
  li:nth-child(3) .card-plate { background: #dfccb4; }
  .card-stop {
    position: absolute;
    z-index: 1;
    left: 9px;
    top: 4px;
    color: #274a3d;
    font: 700 clamp(18px, 1.8vw, 25px)/1.5 Arial, sans-serif;
    font-variant-numeric: tabular-nums;
  }
  .card-plate img {
    position: absolute;
    width: auto;
    height: 116%;
    max-width: none;
  }
  .plant-rail-card h3 { margin-top: 6px; font-size: clamp(18px, 2vw, 24px); line-height: 1.4; }
  .plant-rail-card:hover h3 { color: var(--teal-bright); }
  .plant-rail-card p, .game-copy p { margin-top: 2px; color: var(--muted); font-size: clamp(13px, 1.2vw, 16px); line-height: 1.55; }
  .trail-game {
    justify-content: start;
    margin: clamp(20px, 3vw, 42px) var(--gutter) 0;
    padding: 17px 0;
    border-top: 1px solid #31443e;
  }
  .game-symbol {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    flex: none;
    border-radius: 5px;
    color: #a0e9cd;
    background: #24453e;
  }
  .game-symbol svg { width: 30px; height: 30px; }
  .trail-game h2 { font-size: clamp(18px, 1.9vw, 23px); }
  .trail-game .shelf-link { margin-left: auto; }

  @media (max-width: 600px) {
    .trail-cover { padding-bottom: 10px; }
    .stop-cards {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 38vw;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--gutter));
      padding: 3px var(--gutter) 6px;
      scroll-snap-type: x proximity;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .stop-cards::-webkit-scrollbar { display: none; }
    .stop-cards li { scroll-snap-align: start; }
    .stop-cards a:focus-visible { outline-offset: 0; }
    .card-plate { aspect-ratio: 1.32; }
    .shelf-link { font-size: 13px; }
  }
  @media (max-width: 355px) {
    .cover-actions a { padding-inline: 12px; font-size: 14px; }
    .shelf-heading h2 { font-size: 21px; }
  }
</style>
