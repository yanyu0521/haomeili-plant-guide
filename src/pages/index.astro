---
import BaseLayout from '../layouts/BaseLayout.astro';
import ForestMap from '../components/ForestMap.astro';
import { publishedPlants } from '../lib/plants';
import { plantPath, sitePath } from '../lib/paths';
import mapPlate from '../../assets/plates/map-art.png';
import routeThread from '../../assets/plates/route-thread.svg';
import heroWaves from '../../assets/plates/hero-waves.svg';

const firstPlants = publishedPlants.slice(0, 3);
---
<BaseLayout title="好美里 1920 保安林" description="沿著海風，認識好美里防風林參考地圖上的 15 個植物導覽點。查看植物介紹與語音導覽。">
  <div class="home-page">
    <div class="home-decorations" aria-hidden="true">
      <img class="home-wave-plate" src={heroWaves.src} alt="" aria-hidden="true" />
      <i class="home-wave home-wave--actions"></i>
      <i class="home-wave home-wave--actions-secondary"></i>
      <i class="home-wave home-wave--plants"></i>
      <i class="home-wave home-wave--guide"></i>
      <img class="route-map" src={routeThread.src} alt="" aria-hidden="true" />
    </div>

    <section class="home-intro" aria-labelledby="home-title">
      <h1 class="home-title" id="home-title">好美里 1920 保安林</h1>
      <p class="home-subtitle">沿著海風，認識林中的植物</p>
      <div class="home-actions">
        <a class="button button-primary" href={sitePath('map/')}>
          <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 23S2 14 2 8a10 10 0 1 1 20 0c0 6-10 15-10 15Z" />
            <circle cx="12" cy="8" r="3.5" />
          </svg>
          <span>查看植物分布地圖</span>
          <svg class="button-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 3 18 12 8 21" /></svg>
        </a>
        <a class="button button-secondary" href={sitePath('plants/#audio-guide')}>
          <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M3 9v6h5l7 5V4L8 9H3Z" />
            <path d="M18 8a6 6 0 0 1 0 8M20 5a10 10 0 0 1 0 14" />
          </svg>
          <span>聽植物語音導覽</span>
        </a>
      </div>
    </section>

    <section class="home-map-section" aria-labelledby="map-preview-title">
      <div class="home-section-heading">
        <span class="route-index" aria-hidden="true">01</span>
        <h2 id="map-preview-title">地圖預覽</h2>
      </div>
      <p class="map-note">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="10.5" />
          <circle class="map-note-dot" cx="12" cy="7.5" r="1.45" />
          <path d="M12 11v6" />
        </svg>
        <span>圖上點位依參考地圖標註，並非 GPS 座標</span>
      </p>
      <a class="home-map-link" href={sitePath('map/')} aria-label="開啟好美里保安林互動地圖">
        <div class="home-map" aria-label="好美里保安林參考地圖預覽">
          <ForestMap plants={publishedPlants} compact={true} mapArtwork={mapPlate.src} showMarkers={false} controls={false} />
        </div>
      </a>
      <div class="home-map-action">
        <span>互動地圖有 15 個可搜尋的植物導覽點</span>
        <a class="text-link" href={sitePath('map/')}>開啟互動地圖 <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="plant-rail-section" aria-labelledby="plant-rail-title">
      <div class="home-section-heading">
        <span class="route-index" aria-hidden="true">02</span>
        <h2 id="plant-rail-title">在林徑上遇見</h2>
      </div>
      <ol class="plant-rail">
        {firstPlants.map((plant, index) => (
          <li>
            <a class="plant-rail-card" href={plantPath(plant.slug)} aria-label={`第 ${index + 1} 個點位：${plant.name}，查看植物介紹`}>
              <span class="plant-rail-number" aria-hidden="true"><span>{index + 1}</span></span>
              {index === 0 ? (
                <svg class="plant-rail-art" viewBox="6 6 52 52" aria-hidden="true" focusable="false">
                  <path d="M12 53C14 32 31 14 53 11c1 21-15 39-41 42Z" />
                  <path d="M12 53C25 40 35 30 49 17M24 41l-1-10m10 1 8-7" />
                </svg>
              ) : index === 1 ? (
                <svg class="plant-rail-art" viewBox="6 6 52 52" aria-hidden="true" focusable="false">
                  <path d="M9 56 55 8M16 49l-6-10m14 3-5-13m13 6-2-14m11 5 4-13M18 47l10-7m7-8 11-4M25 40l-7 6m15-15 8-7m-28 27 8-2m17-25 10-3" />
                </svg>
              ) : (
                <svg class="plant-rail-art" viewBox="6 6 52 52" aria-hidden="true" focusable="false">
                  <path d="M9 56C22 45 38 29 55 8M18 48l-6-10m15 4-4-13m13 6-1-14m10 5 4-13M21 45l9-5m7-8 11-4M28 39l-8 7m15-14 8-7" />
                  <path d="M12 45C5 42 4 37 7 33c6 1 9 5 9 10Zm9-9c-5-6-3-11 2-14 5 4 6 8 2 13Zm10-8c-4-6-1-11 4-13 4 4 3 9-1 14Zm9-9c0-6 4-9 10-8 0 6-3 10-10 11ZM27 41c-2 6 1 10 7 12 3-5 1-9-5-12Zm11-10c3 6 8 7 13 4-2-5-6-7-11-5Z" fill="currentColor" stroke="none" />
                </svg>
              )}
              <span class="plant-rail-label">
                {plant.name}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 3 18 12 8 21" /></svg>
              </span>
            </a>
          </li>
        ))}
        <li>
          <a class="plant-count-card" href={sitePath('plants/')} aria-label={`瀏覽全部 ${publishedPlants.length} 個植物導覽點`}>
            <span class="plant-count">{publishedPlants.length}</span>
            <span class="plant-count-caption">
              <span class="plant-count-label"><span>個導覽點</span></span>
              <svg viewBox="0 0 24 24" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M4.83 7.5 13.83 14 4.83 20" /></svg>
            </span>
          </a>
        </li>
      </ol>
    </section>

    <a class="guide-link" href={sitePath('plants/')}>
      <svg class="guide-book-icon" viewBox="0 0 56 44" aria-hidden="true" focusable="false">
        <path d="M28 9C22 3 12 2 3 4v32c9-2 19-1 25 5V9Zm0 0c6-6 16-7 25-5v32c-9-2-19-1-25 5V9Z" />
      </svg>
      <span class="guide-link-copy">
        <strong>植物導覽</strong>
        <span>選擇植物，查看介紹、辨識重點與語音導覽</span>
      </span>
      <svg class="guide-link-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 2 18 12 6 22" /></svg>
    </a>

    <section class="game-next-step" aria-labelledby="game-title">
      <div>
        <h2 id="game-title">延伸學習・岸全第一海岸風險教育桌遊</h2>
        <p>完成林徑導覽後，接著用遊戲認識海岸風險與守護行動。</p>
      </div>
      <a class="text-link" href="https://haomeili-game.angela950730.workers.dev/" target="_blank" rel="noopener noreferrer">
        開始遊戲
        <svg class="external-link-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M9 2h5v5M14 2 7 9M12 9v4a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h4" /></svg>
      </a>
    </section>
  </div>
</BaseLayout>
