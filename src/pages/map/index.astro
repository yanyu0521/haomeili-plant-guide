---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ForestMap from '../../components/ForestMap.astro';
import { publishedPlants } from '../../lib/plants';
import { plantPath } from '../../lib/paths';

const families = [...new Set(publishedPlants.map((plant) => plant.family))];
const searchIndex = (plant: (typeof publishedPlants)[number]) =>
  [plant.name, plant.scientificName, plant.family, ...(plant.aliases ?? [])].join(' ').toLocaleLowerCase('zh-Hant');
---
<BaseLayout title="植物分布地圖" description="在好美里 1920 保安林地圖上，選擇標記探索植物與其生長位置。">
  <div class="container--wide map-page">
    <header class="page-heading map-heading">
      <h1>沿著林徑找到植物</h1>
      <p class="lead">搜尋植物名稱、學名或科別，快速定位地圖點位；點選標記或名錄即可開啟個別介紹。</p>
    </header>

    <div class="map-layout" data-map-explorer>
      <section class="map-panel" aria-label="植物分布圖">
        <div class="map-panel-heading">
          <h2>好美里 1920 保安林</h2>
          <p>嘉義縣布袋鎮・美漾森林</p>
        </div>
        <ForestMap plants={publishedPlants} showCredit={true} />
        <div class="map-legend" aria-label="地圖圖例">
          <span><i class="legend-forest"></i>保安林</span>
          <span><i class="legend-water"></i>水道與濕地</span>
          <span><i class="legend-trail"></i>步道與道路</span>
          <span class="map-search-legend" data-map-search-legend hidden><i class="legend-search"></i>符合篩選</span>
        </div>
      </section>

      <aside class="map-index" aria-labelledby="map-index-title">
        <div class="map-index-heading">
          <h2 id="map-index-title">地圖點位</h2>
          <span data-map-count aria-live="polite">{publishedPlants.length} 個導覽點</span>
        </div>
        <div class="map-index-filters">
          <div class="map-filter-fields">
            <div class="map-filter-field map-filter-field--search">
              <label for="map-plant-search">搜尋植物</label>
              <input id="map-plant-search" type="search" data-map-search placeholder="名稱、學名、別名" autocomplete="off" />
            </div>
            <div class="map-filter-field">
              <label for="map-family-filter">依科別篩選</label>
              <select id="map-family-filter" data-map-family>
                <option value="">全部科別</option>
                {families.map((family) => <option value={family}>{family}</option>)}
              </select>
            </div>
          </div>
          <div class="map-filter-footer">
            <p class="map-filter-help">結果會同步顯示在地圖與名錄。</p>
            <button class="map-filter-clear" type="button" data-map-clear disabled>清除條件</button>
          </div>
        </div>
        <ol class="map-index-list">
          {publishedPlants.map((plant, index) => (
            <li data-map-index-item data-map-slug={plant.slug} data-map-family={plant.family} data-map-search-index={searchIndex(plant)}>
              <a href={plantPath(plant.slug)}>
                <span class="map-index-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="map-index-copy">
                  <strong>{plant.name}</strong>
                  <em lang="la">{plant.scientificName}</em>
                </span>
                <span class="map-index-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="map-index-empty" data-map-empty hidden>沒有符合的植物，請調整搜尋文字或科別。</p>
        <p class="map-index-note">點位來自參考地圖，標示的是圖面位置，不是精確經緯度。</p>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll('[data-map-explorer]').forEach((explorerElement) => {
    if (!(explorerElement instanceof HTMLElement)) return;
    const explorer = explorerElement;
    const searchInput = explorer.querySelector('[data-map-search]');
    const familyFilter = explorer.querySelector('[data-map-family]');
    const clearButton = explorer.querySelector('[data-map-clear]');
    const countLabel = explorer.querySelector('[data-map-count]');
    const emptyState = explorer.querySelector('[data-map-empty]');
    const searchLegend = explorer.querySelector('[data-map-search-legend]');
    const list = explorer.querySelector('.map-index-list');
    const items = Array.from(explorer.querySelectorAll('[data-map-index-item]'))
      .filter((item): item is HTMLElement => item instanceof HTMLElement);

    function findMarker(slug = '') {
      return Array.from(explorer.querySelectorAll('.map-marker[data-map-slug]')).find((marker) =>
        marker instanceof HTMLAnchorElement && marker.dataset.mapSlug === slug,
      );
    }

    function applyFilters() {
      const query = searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLocaleLowerCase('zh-Hant') : '';
      const family = familyFilter instanceof HTMLSelectElement ? familyFilter.value : '';
      const hasFilter = Boolean(query || family);
      let visibleCount = 0;

      items.forEach((item) => {
        if (!(item instanceof HTMLElement)) return;
        const matchesQuery = !query || (item.dataset.mapSearchIndex || '').includes(query);
        const matchesFamily = !family || item.dataset.mapFamily === family;
        const matches = matchesQuery && matchesFamily;
        const isFirstVisible = matches && visibleCount === 0;

        item.hidden = !matches;
        item.classList.toggle('map-index-item--first-visible', isFirstVisible);

        const marker = findMarker(item.dataset.mapSlug || '');
        if (marker instanceof HTMLAnchorElement) {
          marker.hidden = !matches;
          marker.classList.toggle('map-marker--search-hit', matches && hasFilter);
          marker.classList.remove('map-marker--preview', 'map-marker--dimmed');
        }

        if (matches) visibleCount += 1;
      });

      if (list instanceof HTMLElement) list.classList.toggle('map-index-list--filtered', hasFilter);
      if (countLabel instanceof HTMLElement) countLabel.textContent = hasFilter ? `顯示 ${visibleCount} / ${items.length} 個導覽點` : `${items.length} 個導覽點`;
      if (emptyState instanceof HTMLElement) emptyState.hidden = visibleCount > 0;
      if (clearButton instanceof HTMLButtonElement) clearButton.disabled = !hasFilter;
      if (searchLegend instanceof HTMLElement) searchLegend.hidden = !hasFilter;
      const map = explorer.querySelector('[data-forest-map]');
      const visibleSlugs = items.filter((item) => !item.hidden).map((item) => item.dataset.mapSlug || '');
      if (map instanceof HTMLElement) map.dispatchEvent(new CustomEvent('map:fit', { detail: { slugs: hasFilter ? visibleSlugs : [] } }));
    }

    function highlightPlant(slug = '') {
      explorer.querySelectorAll('.map-marker[data-map-slug]').forEach((marker) => {
        if (!(marker instanceof HTMLAnchorElement)) return;
        const markerSlug = marker.dataset.mapSlug || '';
        const isPreview = Boolean(slug) && markerSlug === slug;
        marker.classList.toggle('map-marker--preview', isPreview);
        marker.classList.toggle('map-marker--dimmed', Boolean(slug) && markerSlug !== slug && !marker.hidden);
      });
    }

    items.forEach((item) => {
      if (!(item instanceof HTMLElement)) return;
      const link = item.querySelector('a');
      const slug = item.dataset.mapSlug || '';
      item.addEventListener('pointerenter', () => highlightPlant(slug));
      item.addEventListener('pointerleave', () => highlightPlant(''));
      link?.addEventListener('focus', () => highlightPlant(slug));
      link?.addEventListener('blur', () => highlightPlant(''));
    });

    searchInput?.addEventListener('input', applyFilters);
    familyFilter?.addEventListener('change', applyFilters);
    clearButton?.addEventListener('click', () => {
      if (searchInput instanceof HTMLInputElement) searchInput.value = '';
      if (familyFilter instanceof HTMLSelectElement) familyFilter.value = '';
      applyFilters();
      if (searchInput instanceof HTMLInputElement) searchInput.focus();
    });
  });
</script>
