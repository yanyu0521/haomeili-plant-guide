---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ForestMap from '../../components/ForestMap.astro';
import { publishedPlants } from '../../lib/plants';
import { plantPath } from '../../lib/paths';

const families = [...new Set(publishedPlants.map((plant) => plant.family))];
const searchIndex = (plant: (typeof publishedPlants)[number]) =>
  [plant.name, plant.scientificName, plant.family, ...(plant.aliases ?? [])].join(' ').toLocaleLowerCase('zh-Hant');
---
<BaseLayout title="植物分布地圖" description="在好美里 1920 保安林地圖上，選擇標記探索植物與其生長位置。">
  <div class="container--wide map-page">
    <header class="page-heading map-heading">
      <h1>步道植物地圖</h1>
      <p class="lead">點站號看植物。遇到「3 個點」這類標記，點一下就能選站。</p>
    </header>

    <div class="map-layout" data-map-explorer>
      <div class="map-index-filters" role="search" aria-label="搜尋植物點位">
        <div class="map-filter-fields">
          <div class="map-filter-field map-filter-field--search">
            <label for="map-plant-search">搜尋植物</label>
            <input id="map-plant-search" type="search" data-map-search placeholder="例如 05、水黃皮" autocomplete="off" />
          </div>
          <div class="map-filter-field">
            <label for="map-family-filter">依科別篩選</label>
            <select id="map-family-filter" data-map-family>
              <option value="">全部科別</option>
              {families.map((family) => <option value={family}>{family}</option>)}
            </select>
          </div>
        </div>
        <div class="map-filter-footer">
          <p class="map-filter-help" data-map-count role="status">{publishedPlants.length} 個植物導覽點</p>
          <button class="map-filter-clear" type="button" data-map-clear disabled>清除篩選</button>
        </div>
      </div>

      <section class="map-panel" aria-label="植物分布圖">
        <div class="map-panel-heading">
          <h2>好美里 1920 保安林</h2>
          <p>嘉義縣布袋鎮・美漾森林</p>
        </div>
        <ForestMap plants={publishedPlants} showCredit={true} />
        <div class="map-legend" aria-label="地圖圖例">
          <span><i class="legend-forest"></i>保安林</span>
          <span><i class="legend-water"></i>水道與濕地</span>
          <span><i class="legend-trail"></i>步道與道路</span>
          <span class="map-search-legend" data-map-search-legend hidden><i class="legend-search"></i>符合篩選</span>
        </div>
      </section>

      <aside class="map-index" aria-labelledby="map-index-title">
        <div class="map-index-heading">
          <h2 id="map-index-title">地圖點位</h2>
        </div>
        <ol class="map-index-list">
          {publishedPlants.map((plant, index) => (
            <li data-map-index-item data-map-number={index + 1} data-map-slug={plant.slug} data-map-family={plant.family} data-map-search-index={searchIndex(plant)}>
              <a href={plantPath(plant.slug)}>
                <span class="map-index-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="map-index-copy">
                  <strong>{plant.name}</strong>
                  <em lang="la">{plant.scientificName}</em>
                </span>
                <span class="map-index-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="map-index-empty" data-map-empty hidden>沒有符合的植物，請調整搜尋文字或科別。</p>
        <p class="map-index-note">點位來自參考地圖，標示的是圖面位置，不是精確經緯度。</p>
      </aside>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .map-page .map-layout {
    grid-template-areas: 'map filters' 'map points';
    grid-template-rows: auto 1fr;
    row-gap: 12px;
  }
  .map-page .map-panel { grid-area: map; scroll-margin-block-start: 12px; }
  .map-page .map-index { grid-area: points; }
  .map-page .map-index-filters {
    grid-area: filters;
    border: 1px solid #31545a;
    border-radius: 12px;
  }
  .map-page .map-filter-help { font-size: 12px; }
  .map-page .map-filter-clear { min-height: 36px; }

  @media (max-width: 900px) {
    .map-page .map-layout { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'filters' 'map' 'points'; grid-template-rows: auto; }
    .map-page .map-filter-fields { grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); }
    .map-page .map-filter-field input, .map-page .map-filter-field select { min-height: 44px; font-size: 16px; }
    .map-page .map-filter-clear { min-height: 44px; }
    .map-page .map-index-filters { gap: 2px; padding-bottom: 4px; }
  }
</style>

<script>
  document.querySelectorAll('[data-map-explorer]').forEach((explorerElement) => {
    if (!(explorerElement instanceof HTMLElement)) return;
    const explorer = explorerElement;
    const searchInput = explorer.querySelector('[data-map-search]');
    const familyFilter = explorer.querySelector('[data-map-family]');
    const clearButton = explorer.querySelector('[data-map-clear]');
    const countLabel = explorer.querySelector('[data-map-count]');
    const emptyState = explorer.querySelector('[data-map-empty]');
    const searchLegend = explorer.querySelector('[data-map-search-legend]');
    const list = explorer.querySelector('.map-index-list');
    const map = explorer.querySelector('[data-forest-map]');
    const mapPanel = map?.closest('.map-panel');
    const markers = Array.from(explorer.querySelectorAll<HTMLAnchorElement>('.map-marker[data-map-slug]'));
    const items = Array.from(explorer.querySelectorAll('[data-map-index-item]'))
      .filter((item): item is HTMLElement => item instanceof HTMLElement);
    const pointHashPrefix = '#map-point-';

    function findMarker(slug = '') {
      return markers.find((marker) => marker.dataset.mapSlug === slug);
    }

    function clearPointHash() {
      if (!location.hash.startsWith(pointHashPrefix)) return;
      history.replaceState(history.state, '', `${location.pathname}${location.search}`);
    }

    function applyFilters() {
      const query = searchInput instanceof HTMLInputElement ? searchInput.value.normalize('NFKC').trim().toLocaleLowerCase('zh-Hant') : '';
      const pointNumber = query.match(/^(?:第\s*)?(\d{1,2})(?:\s*[號點])?$/)?.[1];
      const family = familyFilter instanceof HTMLSelectElement ? familyFilter.value : '';
      const hasFilter = Boolean(query || family);
      const visibleSlugs: string[] = [];

      items.forEach((item) => {
        const matchesQuery = pointNumber
          ? Number(item.dataset.mapNumber) === Number(pointNumber)
          : !query || (item.dataset.mapSearchIndex || '').includes(query);
        const matchesFamily = !family || item.dataset.mapFamily === family;
        const matches = matchesQuery && matchesFamily;
        const isFirstVisible = matches && visibleSlugs.length === 0;

        item.hidden = !matches;
        item.classList.toggle('map-index-item--first-visible', isFirstVisible);

        const marker = findMarker(item.dataset.mapSlug || '');
        if (marker instanceof HTMLAnchorElement) {
          marker.hidden = !matches;
          marker.classList.toggle('map-marker--search-hit', matches && hasFilter);
        }

        if (matches && item.dataset.mapSlug) visibleSlugs.push(item.dataset.mapSlug);
      });

      const visibleCount = visibleSlugs.length;
      markers.forEach((marker) => marker.classList.toggle('map-marker--single-result',
        hasFilter && visibleCount === 1 && marker.dataset.mapSlug === visibleSlugs[0],
      ));
      if (list instanceof HTMLElement) list.classList.toggle('map-index-list--filtered', hasFilter);
      if (countLabel instanceof HTMLElement) {
        countLabel.textContent = hasFilter
          ? visibleCount ? `找到 ${visibleCount} 個植物導覽點` : '沒有符合的植物'
          : `${items.length} 個植物導覽點`;
      }
      if (emptyState instanceof HTMLElement) emptyState.hidden = visibleCount > 0;
      if (clearButton instanceof HTMLButtonElement) clearButton.disabled = !hasFilter;
      if (searchLegend instanceof HTMLElement) searchLegend.hidden = !hasFilter || visibleCount === 0;
      if (map instanceof HTMLElement) map.dispatchEvent(new CustomEvent('map:fit', { detail: { slugs: hasFilter ? visibleSlugs : [], filtered: hasFilter } }));
    }

    function resetFilters() {
      if (searchInput instanceof HTMLInputElement) searchInput.value = '';
      if (familyFilter instanceof HTMLSelectElement) familyFilter.value = '';
      applyFilters();
    }

    function locateFromHash() {
      if (!(map instanceof HTMLElement) || !location.hash.startsWith(pointHashPrefix)) return;
      const slug = location.hash.slice(pointHashPrefix.length);
      if (!findMarker(slug)) return;
      resetFilters();
      map.dispatchEvent(new CustomEvent('map:locate', { detail: { slug } }));
      const alignMap = () => requestAnimationFrame(() => {
        if (location.hash === `${pointHashPrefix}${slug}`) {
          map.scrollTop = 0;
          map.scrollLeft = 0;
          mapPanel?.scrollIntoView({ block: 'start', behavior: 'instant' });
        }
      });
      // The browser may scroll to the marker fragment again while the page loads.
      if (document.readyState === 'complete') alignMap();
      else window.addEventListener('load', alignMap, { once: true });
    }

    let hoveredSlug = '';
    let focusedSlug = '';
    function highlightPlant() {
      map?.dispatchEvent(new CustomEvent('map:preview', { detail: { slug: hoveredSlug || focusedSlug } }));
    }

    items.forEach((item) => {
      const link = item.querySelector('a');
      const slug = item.dataset.mapSlug || '';
      item.addEventListener('pointerenter', () => {
        hoveredSlug = slug;
        highlightPlant();
      });
      item.addEventListener('pointerleave', () => {
        hoveredSlug = '';
        highlightPlant();
      });
      link?.addEventListener('focus', () => {
        focusedSlug = slug;
        hoveredSlug = '';
        highlightPlant();
      });
      link?.addEventListener('blur', () => {
        focusedSlug = '';
        highlightPlant();
      });
    });

    function handleFilterChange() {
      clearPointHash();
      applyFilters();
    }

    searchInput?.addEventListener('input', handleFilterChange);
    familyFilter?.addEventListener('change', handleFilterChange);
    clearButton?.addEventListener('click', () => {
      clearPointHash();
      resetFilters();
      if (searchInput instanceof HTMLInputElement) searchInput.focus();
    });
    map?.addEventListener('map:reset', () => {
      clearPointHash();
      resetFilters();
    });
    window.addEventListener('hashchange', (event) => {
      if (location.hash.startsWith(pointHashPrefix)) locateFromHash();
      else if (new URL(event.oldURL).hash.startsWith(pointHashPrefix)) resetFilters();
    });
    if (map instanceof HTMLElement && map.dataset.mapReady === 'true') locateFromHash();
    else map?.addEventListener('map:ready', locateFromHash, { once: true });
  });
</script>
