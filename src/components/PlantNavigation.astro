---
import type { PublishedPlant } from '../lib/plantSchema';
import { plantPath } from '../lib/paths';
interface Props { previous?: PublishedPlant; next?: PublishedPlant }
const { previous, next } = Astro.props;
---
<nav class="plant-pager" aria-label="相鄰植物">
  {previous ? (
    <a class="pager-link" href={plantPath(previous.slug)}>
      <span class="pager-label">← 上一種植物</span>
      <span class="pager-name">{previous.name}</span>
    </a>
  ) : <span class="pager-empty" aria-hidden="true"></span>}
  {next ? (
    <a class="pager-link pager-next" href={plantPath(next.slug)}>
      <span class="pager-label">下一種植物 →</span>
      <span class="pager-name">{next.name}</span>
    </a>
  ) : <span class="pager-empty" aria-hidden="true"></span>}
</nav>
