---
import type { PublishedPlant } from '../lib/plantSchema';
import { plantPath } from '../lib/paths';
interface Props { previous?: PublishedPlant; next?: PublishedPlant }
const { previous, next } = Astro.props;
---
<nav class="plant-pager" aria-label="相鄰植物">
  <a class="pager-link" href={previous ? plantPath(previous.slug) : undefined} data-plant-previous hidden={!previous}>
      <span class="pager-label">← 上一個導覽點</span>
      <span class="pager-name">{previous?.name}</span>
  </a>
  <a class="pager-link pager-next" href={next ? plantPath(next.slug) : undefined} data-plant-next hidden={!next}>
      <span class="pager-label">下一個導覽點 →</span>
      <span class="pager-name">{next?.name}</span>
  </a>
</nav>
