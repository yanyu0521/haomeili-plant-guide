---
import { sitePath } from '../lib/paths';
const isList = Astro.url.pathname === sitePath('plants/');
const isMap = Astro.url.pathname === sitePath('map/');
---
<a class="skip-link" href="#content">跳至主要內容</a>
<header class="site-header">
  <div class="container header-row">
    <a class="brand" href={sitePath()}>
      <span class="brand-mark" style={`--brand-image:url('${sitePath('favicon.svg')}')`} aria-hidden="true"></span>
      <span>好美里植物導覽</span>
    </a>
    <nav aria-label="主要導覽">
      <a class="header-nav" href={sitePath('plants/')} aria-current={isList ? 'page' : undefined}>植物名錄</a>
      <a class="header-nav" href={sitePath('map/')} aria-current={isMap ? 'page' : undefined}>分布地圖</a>
    </nav>
  </div>
</header>
